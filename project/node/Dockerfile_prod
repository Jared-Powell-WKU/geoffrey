# syntax=docker/dockerfile:1
# Production image. It contains no secrets: configuration arrives as
# environment variables from the stack's env file on the host.

FROM node:22-slim AS build
WORKDIR /build
# The chromedriver package downloads a browser driver on install. Only the
# disabled EV watcher uses it, and this image has no Chrome to drive.
ENV CHROMEDRIVER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && rm -rf dist/test

FROM node:22-slim AS deps
WORKDIR /build
ENV CHROMEDRIVER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /build/node_modules ./node_modules
COPY package.json ./
COPY --from=build /build/dist ./
USER node
CMD ["node", "/app/index.js"]
