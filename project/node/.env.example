# Copy to .env and fill in. Never commit the real file and never bake it into an image.

# Discord application
CLIENT_TOKEN=your-bot-token
CLIENT_ID=000000000000000000

# Supported guilds. MUST be a single line of JSON wrapped in single quotes.
# The key of each entry is a short name for the guild (deploy.ts expects
# "tncord" and "clantus"); channels lists the channel ids whose attachments are
# saved for /homies and /cute. The first channel of a category also receives
# the notice when an image is added on cantus.dev.
GUILDS='{"tncord":{"guildId":"000000000000000000","adminRoleName":"Mods","channels":{"homies":["000000000000000000"],"pets":["000000000000000000"]}},"clantus":{"guildId":"000000000000000000","adminRoleName":"Mods","channels":{"homies":["000000000000000000"],"pets":[]}}}'

# MariaDB. DB_HOST defaults to "mariadb", the compose service name.
DB_HOST=mariadb
DB_USER=geoffrey
DB_PASSWORD=change-me
DB_NAME=tncord

# Required by deploy.ts (slash command registration). "test" skips the tncord
# guild; any other non-empty value registers commands in every guild.
TEST_INSTANCE=prod

# Private API for cantus.dev (contract: cantus.dev/docs/geoffrey-internal-api.md).
# The API only starts when the key is at least 32 characters; it must equal
# GEOFFREY_API_KEY on the site. Generate one with: openssl rand -hex 32
INTERNAL_API_KEY=
INTERNAL_API_PORT=8787
# One Discord user id. Through the API that person is a member and a moderator
# of every guild in GUILDS that the bot is in, whether or not the account is in
# the guild: they see every pool and can remove any submission. Empty or not a
# valid id: nobody is the owner (an invalid value logs one warning at startup).
OWNER_USER_ID=

# Maintenance. Two jobs live in src/maintenance:
# - backfillOrigins.ts runs inside the bot. Rows from before channelId and
#   messageId existed get their original Discord message looked up, at most 12
#   channel requests five seconds apart every five minutes, until the backlog is
#   done. It only ever updates channelId, messageId and originCheckedAt, and it
#   logs one line per run. Set ORIGIN_BACKFILL=off to keep it from starting.
# - sweepDeadMedia.ts is run by hand (node /app/maintenance/sweepDeadMedia.js
#   [--apply] [--limit N]) and archives attachments that are gone from Discord.
ORIGIN_BACKFILL=
# - reactionCounts.ts runs inside the bot too. It counts the reactions on the
#   Discord message of every stored row (all emoji, and camera-flash ones, the
#   bot's own excluded) for the site's leaderboards: reaction events keep them
#   current, and a job counts the backlog, 25 message requests two seconds
#   apart every 90 seconds, then rechecks rows older than 30 days. It only ever
#   updates reactionCount, flashCount and reactionsCheckedAt. Set
#   REACTION_COUNTS=off to keep it from starting.
REACTION_COUNTS=

# File the container healthcheck reads. Defaults to /tmp/geoffrey-health.
HEALTH_FILE=/tmp/geoffrey-health
