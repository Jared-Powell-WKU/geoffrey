# Copy to .env and fill in. Never commit the real file and never bake it into an image.

# Discord application
CLIENT_TOKEN=your-bot-token
CLIENT_ID=000000000000000000

# Supported guilds. MUST be a single line of JSON wrapped in single quotes.
# The key of each entry is a short name for the guild (deploy.ts expects
# "tncord" and "clantus"); channels lists the channel ids whose attachments are
# saved for /homies and /cute. The first channel of a category also receives
# the notice when an image is added on cantus.dev.
GUILDS='{"tncord":{"guildId":"000000000000000000","adminRoleName":"Mods","channels":{"homies":["000000000000000000"],"pets":["000000000000000000"]}},"clantus":{"guildId":"000000000000000000","adminRoleName":"Mods","channels":{"homies":["000000000000000000"],"pets":[]}}}'

# MariaDB. DB_HOST defaults to "mariadb", the compose service name.
DB_HOST=mariadb
DB_USER=geoffrey
DB_PASSWORD=change-me
DB_NAME=tncord

# Required by deploy.ts (slash command registration). "test" skips the tncord
# guild; any other non-empty value registers commands in every guild.
TEST_INSTANCE=prod

# Private API for cantus.dev (contract: cantus.dev/docs/geoffrey-internal-api.md).
# The API only starts when the key is at least 32 characters; it must equal
# GEOFFREY_API_KEY on the site. Generate one with: openssl rand -hex 32
INTERNAL_API_KEY=
INTERNAL_API_PORT=8787

# File the container healthcheck reads. Defaults to /tmp/geoffrey-health.
HEALTH_FILE=/tmp/geoffrey-health
