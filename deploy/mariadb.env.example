# /opt/stacks/discord-bot/mariadb.env on the droplet. Mode 600.
# MARIADB_ROOT_PASSWORD only takes effect when the data volume is first
# created, but the backup cron and the pre-deploy hook read it from the
# container's environment, so it must match the real root password.
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=tncord
