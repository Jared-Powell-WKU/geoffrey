# /opt/stacks/discord-bot/geoffrey.env on the droplet. Mode 600. Never in git,
# never in an image. Docker Compose reads this file, so every value must be on
# ONE line. GUILDS is JSON on a single line wrapped in single quotes.
CLIENT_TOKEN=
CLIENT_ID=
TEST_INSTANCE=prod
GUILDS='{"example":{"guildId":"000000000000000000","adminRoleName":"Mod","channels":{"homies":["000000000000000000"],"pets":["000000000000000000"]}}}'
DB_USER=
DB_PASSWORD=
DB_NAME=tncord
# Shared with cantus.dev as GEOFFREY_API_KEY. At least 32 characters. Leave
# empty to keep the internal API switched off.
INTERNAL_API_KEY=
INTERNAL_API_PORT=8787
